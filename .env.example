# Copie este arquivo para .env.local e preencha com as credenciais do seu App Meta.
# Nunca commite o arquivo .env.local nem cole tokens reais em conversas/chats.

# String de conexão do PostgreSQL. No Railway, ao adicionar o serviço
# "PostgreSQL" ao projeto, essa variável é injetada automaticamente — não
# precisa preencher manualmente lá. Para rodar localmente, aponte para um
# Postgres local, ex: postgres://usuario:senha@localhost:5432/manychat
DATABASE_URL=

# Token de acesso da Página conectada à conta profissional do Instagram
# (Graph API > Instagram Messaging). Gerado em developers.facebook.com.
INSTAGRAM_ACCESS_TOKEN=

# App Secret do seu App Meta — usado para validar a assinatura dos webhooks recebidos.
INSTAGRAM_APP_SECRET=

# Token arbitrário que você escolhe e usa para validar o handshake do webhook
# (precisa ser o mesmo valor configurado no painel de Webhooks da Meta).
INSTAGRAM_VERIFY_TOKEN=
